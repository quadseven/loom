#!/usr/bin/env bash
set -uo pipefail
[ "${1:-}" = get ] || exit 0
# shellcheck source=lanes/github_auth.sh
. "${BASH_SOURCE[0]%/*}/../github_auth.sh" || exit 1

protocol="" host=""
while IFS='=' read -r key value; do
  case "$key" in
    '') break ;;
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

# Tell Git to quit if the token is missing. Later helpers and prompts must
# never supply a different credential for this request.
if ! github_read_token token; then
  printf 'quit=true\n'
  exit 0
fi
printf 'username=x-access-token\npassword=%s\n' "$token"
