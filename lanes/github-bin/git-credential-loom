#!/usr/bin/env bash
# git's only credential helper for github.com in a Loom process
# (lanes/github_auth.sh, loom#3083): it answers with this process's App
# token, and without one it tells git to quit, so no later helper or prompt
# supplies a person's credential.
set -uo pipefail
[ "${1:-}" = get ] || exit 0
protocol="" host=""
while IFS='=' read -r key value; do
  case "$key" in
    '') break ;;
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
if [[ "${GH_TOKEN:-}" =~ ^ghs_[A-Za-z0-9_.-]+$ ]]; then
  printf 'username=x-access-token\npassword=%s\n' "$GH_TOKEN"
else
  printf 'quit=true\n'
fi
