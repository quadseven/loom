#!/usr/bin/env bash
set -u

[ "${1:-}" = get ] || exit 0
[[ "${GH_TOKEN:-}" =~ ^ghs_[A-Za-z0-9_.-]+$ ]] || exit 0
protocol="" host=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
printf 'username=x-access-token\npassword=%s\n\n' "$GH_TOKEN"
