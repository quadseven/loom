#!/usr/bin/env bash
# git-credential-loom: Git credential helper that uses the Loom App token.
# Reads credential request from stdin, outputs credential on stdout.
# Fails closed: if gh-token fails, exits non-zero.

set -uo pipefail

LANES_DIR="$(cd "$(dirname "$0")" && pwd)"

# Read the credential request (protocol, host, etc.) from stdin.
# We only care about https://github.com.
while IFS= read -r line; do
    case "$line" in
        protocol=*) PROTO="${line#protocol=}" ;;
        host=*) HOST="${line#host=}" ;;
    esac
done

# Only handle GitHub HTTPS.
if [[ "$PROTO" != "https" || "$HOST" != "github.com" ]]; then
    exit 0
fi

# Get the App token.
token="$("$LANES_DIR/gh-token")" || exit $?

# Output the credential.
cat <<EOF
protocol=https
host=github.com
username=loom
password=$token
EOF