# Copy the keys you need into the environment before running the installer.
LOOM_HOME="YOUR_LOCAL_LOOM_DIRECTORY"
LOOM_REPOS="YOUR_OWNER/YOUR_REPO"
LOOM_BRIEF_AUTHORS="YOUR_TRUSTED_LOGIN"
# The operators who may answer a Needs you card on the dashboard; empty means
# the person logins of LOOM_BRIEF_AUTHORS. An entry IDENTITY=LOGIN maps a
# proxy identity (LOOM_IDENTITY_HEADER) to a login.
LOOM_OPERATORS=""
# The dashboard's answer token, entered once in the browser (docs/DASHBOARD.md).
LOOM_ANSWER_TOKEN="YOUR_PRIVATE_ANSWER_TOKEN"
# Only when the proxy sets this header from the signed-in identity.
LOOM_IDENTITY_HEADER=""
# Another operator's logins whose loom:ticket briefs this Loom builds like its
# own, without taking their claims; their journals, proofs and merges are not
# trusted (docs/LANES.md, Trusted briefers). Space separated; empty is none.
LOOM_TRUSTED_BRIEFERS=""
LOOM_REPO_OWNERS="YOUR_OWNER"
LOOM_STATUS_REPO="YOUR_OWNER/YOUR_REPO"
# The repo this checkout deploys from; empty means LOOM_STATUS_REPO. Its merged
# tickets move to loom:shipped when the station deploys their commit.
LOOM_SELF_REPO=""
# Optional station pin targets. Keep real target names and paths in the private
# station environment; the installer copies this JSON into its plist.
LOOM_PIN_TARGETS='[{"repo":"YOUR_OWNER/YOUR_DEPLOY_REPO","path":"YOUR_PIN_FILE", "revision_var":"YOUR_REVISION_VARIABLE","sha256_var":"YOUR_SHA256_VARIABLE","watch":"dashboard/"}]'
# Optional goal ship documents that declare roll-shipped modules and exact SHA pins.
LOOM_ROLL_SHIP_DOCS='[{"goal":"YOUR_OWNER/YOUR_GOAL_REPO#1","repo":"YOUR_OWNER/YOUR_GOAL_REPO","path":"docs/YOUR_SHIP_DOCUMENT.md","gate_url":"https://example.com/family-gate"}]'
# Optional deployment repos whose merged pin pull requests ship the merged
# tickets of the source revision a "# Published from" line names (docs/BRAIN.md).
LOOM_PIN_SHIP_REPOS="YOUR_OWNER/YOUR_DEPLOY_REPO"
# Optional repos nothing deploys: their merged tickets ship at merge.
LOOM_SHIP_ON_MERGE="YOUR_OWNER/YOUR_LIBRARY_REPO"
# Optional repos with their own deploy workflow: a merged ticket ships once a
# successful run of that workflow covers its merge commit (docs/BRAIN.md).
LOOM_SHIP_WORKFLOWS="YOUR_OWNER/YOUR_SERVICE_REPO=deploy.yml"
# Optional repos with many path-scoped deploy workflows: a merged ticket ships
# once each workflow its files trigger has a successful push run carrying it.
LOOM_SHIP_PATH_WORKFLOWS="YOUR_OWNER/YOUR_INFRA_REPO"
LOOM_METRICS_GOAL="YOUR_OWNER/YOUR_REPO#1"
# The goal home factory invariant breaches are filed on; empty means
# LOOM_METRICS_GOAL when it is in the self repo.
LOOM_INVARIANT_GOAL=""
LOOM_DIGEST_HOUR="9"
# Local times of the twice-daily report digest; empty sends each report.
LOOM_REPORT_DIGEST_TIMES="10:00,21:00"
LOOM_DISCORD_WEBHOOK_SSM="/YOUR/PATH/discord-webhook"
LOOM_DISCORD_CHANNEL_ID="YOUR_CHANNEL_ID"
# The name of the SSM parameter that holds the bot token, never the token itself.
LOOM_DISCORD_BOT_TOKEN_SSM="YOUR_SSM_PARAMETER_NAME"
LOOM_AWS_REGION="YOUR_REGION"
# Optional GitHub App for the station, brain and dashboard: all three set
# sends an App installation token minted at run time; any unset keeps
# LOOM_GITHUB_TOKEN. The key setting is the SSM parameter name, never the key.
LOOM_GITHUB_APP_ID="YOUR_APP_ID"
LOOM_GITHUB_APP_INSTALLATION_ID="YOUR_INSTALLATION_ID"
LOOM_GITHUB_APP_KEY_SSM="YOUR_SSM_PARAMETER_NAME"
# Or the App key as a mounted file (the dashboard's Kubernetes secret); it wins over SSM.
LOOM_GITHUB_APP_KEY_FILE="/path/to/your-app-key.pem"
# The installer uses the Codex subscription for private triage when this is set.
LOOM_CODEX_MODEL="YOUR_CODEX_MODEL"
LOOM_AGY_MODEL="gemini-YOUR_MODEL-high"
LOOM_AGY_EFFORT="high"
# Base URL of your spark-gateway. The free slots append their pinned routes.
# A LOOM_FREE_<PROVIDER>_URL overrides one slot's derived route.
LOOM_FREE_GATEWAY_URL="https://your-server.internal"
LOOM_FREE_OLLAMA_URL=""
LOOM_FREE_GEMMA_URL=""
LOOM_FREE_NVIDIA_URL=""
LOOM_FREE_KILO_URL=""
LOOM_FREE_GROQ_URL=""
LOOM_FREE_OLLAMA_MODEL="free/ollama-cloud"
LOOM_FREE_GEMMA_MODEL="free/gemini"
LOOM_FREE_NVIDIA_MODEL="free/nvidia-nim"
LOOM_FREE_KILO_MODEL="free/kilo"
LOOM_FREE_GROQ_MODEL="free/groq"
LOOM_FREE_CONTEXT="120000"
LOOM_FREE_OUTPUT="16384"
# Override only with providers allowed for private rewrites (docs/BRAIN.md).
LOOM_REWRITE_PRIVATE_CMD="lanes/rewrite_agent.sh - codex/YOUR_CODEX_MODEL"
# Optional public triage command; use your own SSM parameter name.
LOOM_REWRITE_CMD="lanes/rewrite_agent.sh YOUR_SSM_PARAMETER_NAME opencode-go/YOUR_MODEL"
# Only needed when LOOM_REWRITE_PRIVATE_CMD includes a claude/ entry: the name
# of the SSM parameter that holds the Claude OAuth token, never the token
# itself. Leave it empty when no claude/ entry is listed.
LOOM_REWRITE_CLAUDE_TOKEN_SSM=""
LOOM_DISCORD_MENTION="YOUR_USER_ID"
LOOM_DISCORD_DEFAULT_GOAL="YOUR_OWNER/YOUR_REPO#1"
LOOM_REVIEW_CHECK="YOUR_REVIEW_CHECK_NAME"
# The review bot's check that reads a pull request's body; empty means "Grug - Chief".
LOOM_PLAN_CHECK=""
# Seconds one repo's read may take in bus.brain status and resume before
# it is named as timed out and the run moves on; empty means 120.
LOOM_REPO_BUDGET=""
LOOM_FACTORY="1"
# Minutes the station watches the deploy of each Loom auto-merge before it
# stops (bus/deploy_watch.py); empty means 60.
LOOM_POST_MERGE_WATCH=""
# A lane whose bad outcomes (bad-work findings, reverts, failed deploys, failed
# proof audits) over LOOM_LANE_DEMOTE_DAYS reach LOOM_LANE_DEMOTE_AT is demoted
# until the operator clears it (bus/scorecard.py); empty means 3 and 7.
LOOM_LANE_DEMOTE_AT=""
LOOM_LANE_DEMOTE_DAYS=""
LOOM_ANTHROPIC_BUDGET_USD="YOUR_BUDGET_USD"
LOOM_ANTHROPIC_BUDGET_SINCE="YYYY-MM-DD"
LOOM_ANTHROPIC_BUDGET_EXPIRES="YYYY-MM-DD"
LOOM_ANTHROPIC_FLOOR_USD="YOUR_FLOOR_USD"
# Provider lanes whose credit you never top up (for example "anthropic"): their
# slots held out of credit are no lane-held invariant breach. Empty counts them.
LOOM_NO_TOPUP=""
# Settle operator-claimed issues (claim:<login>, no loom: label) whose pull
# requests merged with the review check passed: empty or "dry" only logs what
# would be done, "on" writes, "off" skips it (docs/BRAIN.md). The cap is the
# most issues settled a run.
LOOM_SETTLE_CLAIMED="dry"
LOOM_SETTLE_CLAIMED_MAX="10"
# Optional override for component logs scanned each station pass: one
# name=path per line (relative paths are under LOOM_HOME). Leave empty to
# scan the station log, brain log and every lane service log by default.
LOOM_WATCH=""
# Optional station-only map. The command must be read-only, search at most the
# last 24 hours, and use the supplied literal LOOM_EVIDENCE_NEEDLE. A Live
# string written as a template (`sync: ... (waiting)`, "left N file(s)",
# `export <report>: ...`, "account 'X'") is supported: the needle is its longest
# fixed text, and the station keeps only the lines that match the whole
# template. Keep real deployment commands in the private station plist, never
# in this repository. A Live criterion that needs a string absent is verified on an
# empty answer over LOOM_EVIDENCE_WINDOW_HOURS of log (default 24); the command may
# print `loom-evidence-window-hours: N` when its log is shorter (a pod restart).
LOOM_EVIDENCE_WINDOW_HOURS="24"
LOOM_EVIDENCE_CMDS='{"YOUR_OWNER/YOUR_REPO":"kubectl logs deployment/YOUR_DEPLOYMENT --since=24h --timestamps | grep -F -- \"$LOOM_EVIDENCE_NEEDLE\""}'
# Optional station-only map from goal home to one read-only diagnosis command
# (docs/HEALTH.md). It gets a health finding's key in LOOM_HEALTH_KEY and prints
# plain ASCII evidence (rows, log counts, deploy facts); every health brief and
# regression re-brief of that goal quotes up to 40 lines of it. Each key is a
# goal home written owner/name#goal, the goal being its goal issue's number.
LOOM_HEALTH_DIAGNOSE_CMDS='{"YOUR_GOAL_HOME":"YOUR_DIAGNOSE_SCRIPT \"$LOOM_HEALTH_KEY\""}'
# Repos whose own read-only live-evidence adapter (.loom/live-evidence.json on
# the default branch, bus/live_adapter.py) the station's live proof may run, and
# the station variables an adapter is handed (only these, plus PATH, HOME, LANG
# and TMPDIR): name a read-only kubeconfig here, never a GitHub or cloud token.
LOOM_LIVE_EVIDENCE_REPOS=""
LOOM_LIVE_EVIDENCE_PASS_ENV=""
# The non-LOOM variables (comma or space separated) lanes/mac/install.sh
# writes into the station plist when they are set at install time, so a
# reinstall keeps them: name KUBECONFIG here when LOOM_LIVE_EVIDENCE_PASS_ENV
# hands it to an adapter. PATH and HOME are skipped.
LOOM_STATION_PASS_ENV=""

# Dashboard read-only GitHub configuration.
LOOM_DASHBOARD_GITHUB_TOKEN=YOUR_READ_ONLY_GITHUB_TOKEN
LOOM_DASHBOARD_GITHUB_API=https://api.github.com
LOOM_DASHBOARD_PORT=8080
# Empty listens on every interface; give the private-network address.
LOOM_DASHBOARD_HOST=
LOOM_DASHBOARD_BUDGET_FLOOR=500
LOOM_DASHBOARD_REFRESH_SECONDS=60
LOOM_UPLOAD_TOKEN=YOUR_TRANSCRIPT_UPLOAD_TOKEN
# A second private value that can only read the brain handoff packet.
LOOM_HANDOFF_TOKEN=YOUR_HANDOFF_READ_TOKEN

# Optional sources of the Tiers and allowances page (/tiers, docs/DASHBOARD.md).
# The inference gateway's base URL inside the dashboard's own network (it
# serves /ui/stats and /ui/state, no token); empty shows those panels as not
# configured.
LOOM_GATEWAY_URL=http://YOUR_GATEWAY_SERVICE:PORT
# The review bot's stats endpoint and its optional bearer token; empty shows
# the review bot's panels as not configured yet.
LOOM_GRUG_STATS_URL=
LOOM_GRUG_STATS_TOKEN=

# Optional goal homes for the dashboard views. Use OWNER/NAME#N for one goal.
LOOM_IMPROVEMENT_HOMES=YOUR_OWNER/YOUR_REPO#1
