# Copy the keys you need into the environment before running the installer.
LOOM_HOME="YOUR_LOCAL_LOOM_DIRECTORY"
LOOM_REPOS="YOUR_OWNER/YOUR_REPO"
LOOM_BRIEF_AUTHORS="YOUR_TRUSTED_LOGIN"
LOOM_REPO_OWNERS="YOUR_OWNER"
LOOM_STATUS_REPO="YOUR_OWNER/YOUR_REPO"
# The repo this checkout deploys from; empty means LOOM_STATUS_REPO. Its merged
# tickets move to loom:shipped when the station deploys their commit.
LOOM_SELF_REPO=""
# Optional station pin targets. Keep real target names and paths in the private
# station environment; the installer copies this JSON into its plist.
LOOM_PIN_TARGETS='[{"repo":"YOUR_OWNER/YOUR_DEPLOY_REPO","path":"YOUR_PIN_FILE", "revision_var":"YOUR_REVISION_VARIABLE","sha256_var":"YOUR_SHA256_VARIABLE"}]'
LOOM_METRICS_GOAL="YOUR_OWNER/YOUR_REPO#1"
# The goal home factory invariant breaches are filed on; empty means
# LOOM_METRICS_GOAL when it is in the self repo.
LOOM_INVARIANT_GOAL=""
LOOM_DIGEST_HOUR="9"
# Local times of the twice-daily report digest; empty sends each report.
LOOM_REPORT_DIGEST_TIMES="10:00,21:00"
LOOM_DISCORD_WEBHOOK_SSM="/YOUR/PATH/discord-webhook"
LOOM_DISCORD_CHANNEL_ID="YOUR_CHANNEL_ID"
# The name of the SSM parameter that holds the bot token, never the token itself.
LOOM_DISCORD_BOT_TOKEN_SSM="YOUR_SSM_PARAMETER_NAME"
LOOM_AWS_REGION="YOUR_REGION"
LOOM_DISCORD_MENTION="YOUR_USER_ID"
LOOM_DISCORD_DEFAULT_GOAL="YOUR_OWNER/YOUR_REPO#1"
LOOM_REVIEW_CHECK="YOUR_REVIEW_CHECK_NAME"
# The review bot's check that reads a pull request's body; empty means "Grug - Chief".
LOOM_PLAN_CHECK=""
LOOM_FACTORY="1"
LOOM_ANTHROPIC_BUDGET_USD="YOUR_BUDGET_USD"
LOOM_ANTHROPIC_BUDGET_SINCE="YYYY-MM-DD"
LOOM_ANTHROPIC_BUDGET_EXPIRES="YYYY-MM-DD"
LOOM_ANTHROPIC_FLOOR_USD="YOUR_FLOOR_USD"
# Optional override for component logs scanned each station pass: one
# name=path per line (relative paths are under LOOM_HOME). Leave empty to
# scan the station log, brain log and every lane service log by default.
LOOM_WATCH=""
# Optional station-only map. The command must be read-only, search at most the
# last 24 hours, and use the supplied literal LOOM_EVIDENCE_NEEDLE. Keep real
# deployment commands in the private station plist, never in this repository.
LOOM_EVIDENCE_CMDS='{"YOUR_OWNER/YOUR_REPO":"kubectl logs deployment/YOUR_DEPLOYMENT --since=24h --timestamps | grep -F -- \"$LOOM_EVIDENCE_NEEDLE\""}'
# The evidence endpoint the remote brain reads logs and rows through
# (docs/LANES.md). Its config is a private JSON file outside this checkout,
# shaped like lanes/mac/evidence.example.json; empty installs no endpoint.
LOOM_EVIDENCE_CONFIG="YOUR_PRIVATE_EVIDENCE_CONFIG_JSON"
# The name of the SSM parameter holding its bearer token, never the token itself.
LOOM_EVIDENCE_TOKEN_SSM="YOUR_SSM_PARAMETER_NAME"
# This machine's tailnet address; empty asks tailscale ip -4.
LOOM_EVIDENCE_HOST=""
LOOM_EVIDENCE_PORT="7341"

# Dashboard read-only GitHub configuration.
LOOM_DASHBOARD_GITHUB_TOKEN=YOUR_READ_ONLY_GITHUB_TOKEN
LOOM_DASHBOARD_GITHUB_API=https://api.github.com
LOOM_DASHBOARD_PORT=8080
LOOM_DASHBOARD_BUDGET_FLOOR=500
LOOM_DASHBOARD_REFRESH_SECONDS=60
LOOM_UPLOAD_TOKEN=YOUR_TRANSCRIPT_UPLOAD_TOKEN

# Optional goal homes for the dashboard views. Use OWNER/NAME#N for one goal.
LOOM_IMPROVEMENT_HOMES=YOUR_OWNER/YOUR_REPO#1
