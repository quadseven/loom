# Copy and export the keys you need before running the installer. Omit unused
# keys and replace the YOUR_* examples for the features you enable.
LOOM_HOME="YOUR_LOCAL_LOOM_DIRECTORY"
LOOM_REPOS="YOUR_OWNER/YOUR_REPO"
LOOM_BRIEF_AUTHORS="YOUR_TRUSTED_LOGIN"
# The operators who may answer a Needs you card on the dashboard; empty means
# the person logins of LOOM_BRIEF_AUTHORS. An entry IDENTITY=LOGIN maps a
# proxy identity (LOOM_IDENTITY_HEADER) to a login.
LOOM_OPERATORS=""
# The dashboard's answer token, entered once in the browser (docs/DASHBOARD.md).
LOOM_ANSWER_TOKEN="YOUR_PRIVATE_ANSWER_TOKEN"
# Only when the proxy sets this header from the signed-in identity.
LOOM_IDENTITY_HEADER=""
# Another operator's logins whose loom:ticket briefs this Loom builds like its
# own, without taking their claims; their journals, proofs and merges are not
# trusted (docs/LANES.md, Trusted briefers). Space separated; empty is none.
LOOM_TRUSTED_BRIEFERS=""
# Logins whose "Finished:" and dated "Operator answer YYYY-MM-DD:" lines answer
# an ask. They grant nothing else (docs/LANES.md, Ask answerers). Space
# separated, an App as "<slug>[bot]"; empty is none. Set the same value for
# the station, the brain and Muse.
LOOM_ASK_ANSWERERS=""
LOOM_REPO_OWNERS="YOUR_OWNER"
LOOM_STATUS_REPO="YOUR_OWNER/YOUR_REPO"
# The workhorse's journal issue (owner/repo#N) the dashboard roster reads;
# empty means the roster shows brains only.
LOOM_WORKHORSE_JOURNAL=""
# Roster cadence overrides, "holder=seconds" pairs, comma separated (the
# workhorse's key is "workhorse"); empty means the built-in defaults.
LOOM_ROSTER_CADENCES=""
# The repo this checkout deploys from; empty means LOOM_STATUS_REPO. Its merged
# tickets move to loom:shipped when the station deploys their commit.
LOOM_SELF_REPO=""
# Optional station pin targets. Keep real target names and paths in the private
# station environment; the installer copies this JSON into its plist.
LOOM_PIN_TARGETS='[{"repo":"YOUR_OWNER/YOUR_DEPLOY_REPO","path":"YOUR_PIN_FILE", "revision_var":"YOUR_REVISION_VARIABLE","sha256_var":"YOUR_SHA256_VARIABLE","watch":"dashboard/"}]'
# Optional goal ship documents that declare roll-shipped modules and exact SHA pins.
LOOM_ROLL_SHIP_DOCS='[{"goal":"YOUR_OWNER/YOUR_GOAL_REPO#1","repo":"YOUR_OWNER/YOUR_GOAL_REPO","path":"docs/YOUR_SHIP_DOCUMENT.md","gate_url":"https://example.com/family-gate"}]'
# Optional deployment repos whose merged pin pull requests ship the merged
# tickets of the source revision a "# Published from" line names (docs/BRAIN.md).
LOOM_PIN_SHIP_REPOS="YOUR_OWNER/YOUR_DEPLOY_REPO"
# Optional repos nothing deploys: their merged tickets ship at merge.
LOOM_SHIP_ON_MERGE="YOUR_OWNER/YOUR_LIBRARY_REPO"
# Optional repos with their own deploy workflow: a merged ticket ships once a
# successful run of that workflow covers its merge commit (docs/BRAIN.md).
LOOM_SHIP_WORKFLOWS="YOUR_OWNER/YOUR_SERVICE_REPO=deploy.yml"
# Optional repos with many path-scoped deploy workflows: a merged ticket ships
# once each workflow its files trigger has a successful push run carrying it.
LOOM_SHIP_PATH_WORKFLOWS="YOUR_OWNER/YOUR_INFRA_REPO"
LOOM_METRICS_GOAL="YOUR_OWNER/YOUR_REPO#1"
# Remaining core requests reserved for other work and seconds per metrics step.
LOOM_METRICS_RESERVE="1500"
LOOM_METRICS_SECONDS="300"
# The goal home factory invariant breaches are filed on; empty means
# LOOM_METRICS_GOAL when it is in the self repo.
LOOM_INVARIANT_GOAL=""
LOOM_DIGEST_HOUR="9"
# Local times of the twice-daily report digest; empty sends each report.
LOOM_REPORT_DIGEST_TIMES="10:00,21:00"
LOOM_DISCORD_WEBHOOK_SSM="/YOUR/PATH/discord-webhook"
LOOM_DISCORD_CHANNEL_ID="YOUR_CHANNEL_ID"
# The name of the SSM parameter that holds the bot token, never the token itself.
LOOM_DISCORD_BOT_TOKEN_SSM="YOUR_SSM_PARAMETER_NAME"
LOOM_AWS_REGION="YOUR_REGION"
# Optional AWS CLI executable for SSM reads when aws is not on PATH.
# An invalid configured executable refuses the read; it never falls back.
LOOM_AWS_CLI=""
# Optional token when the process does not mint its own GitHub App token.
LOOM_GITHUB_TOKEN=""
# When supplying an installation token directly, set its bot login too.
# The brain launcher supplies this automatically for a token it mints.
LOOM_GITHUB_LOGIN=""
# Optional GitHub App for the station, brain and dashboard. Set both IDs
# and a key source to mint an installation token at run time.
LOOM_GITHUB_APP_ID="YOUR_APP_ID"
LOOM_GITHUB_APP_INSTALLATION_ID="YOUR_INSTALLATION_ID"
LOOM_GITHUB_APP_KEY_SSM="YOUR_SSM_PARAMETER_NAME"
# Or the App key as a mounted file (the dashboard's Kubernetes secret); it wins over SSM.
LOOM_GITHUB_APP_KEY_FILE="/path/to/your-app-key.pem"
# The installer uses the Codex subscription for private triage when this is set.
LOOM_CODEX_MODEL="YOUR_CODEX_MODEL"
LOOM_AGY_MODEL="gemini-YOUR_MODEL-high"
LOOM_AGY_EFFORT="high"
# Base URL of your spark-gateway. The free slots append their pinned routes.
# A LOOM_FREE_<PROVIDER>_URL overrides one slot's derived route.
LOOM_FREE_GATEWAY_URL="https://your-server.internal"
LOOM_FREE_OLLAMA_URL=""
LOOM_FREE_GEMMA_URL=""
LOOM_FREE_NVIDIA_URL=""
LOOM_FREE_KILO_URL=""
LOOM_FREE_GROQ_URL=""
LOOM_FREE_OPENROUTER_URL=""
LOOM_FREE_OLLAMA_MODEL="free/ollama-cloud"
LOOM_FREE_GEMMA_MODEL="free/gemini"
LOOM_FREE_NVIDIA_MODEL="free/nvidia-nim"
LOOM_FREE_KILO_MODEL="free/kilo"
LOOM_FREE_GROQ_MODEL="free/groq"
LOOM_FREE_OPENROUTER_MODEL="free/openrouter"
LOOM_FREE_CONTEXT="120000"
LOOM_FREE_OUTPUT="16384"
# Override only with providers allowed for private rewrites (docs/BRAIN.md).
LOOM_REWRITE_PRIVATE_CMD="lanes/rewrite_agent.sh - codex/YOUR_CODEX_MODEL"
# Optional public triage command; use your own SSM parameter name.
LOOM_REWRITE_CMD="lanes/rewrite_agent.sh YOUR_SSM_PARAMETER_NAME opencode-go/YOUR_MODEL"
# Only needed when LOOM_REWRITE_PRIVATE_CMD includes a claude/ entry: the name
# of the SSM parameter that holds the Claude OAuth token, never the token
# itself. Leave it empty when no claude/ entry is listed.
LOOM_REWRITE_CLAUDE_TOKEN_SSM=""
LOOM_DISCORD_MENTION="YOUR_USER_ID"
LOOM_DISCORD_DEFAULT_GOAL="YOUR_OWNER/YOUR_REPO#1"
LOOM_REVIEW_CHECK="YOUR_REVIEW_CHECK_NAME"
# The review bot's check that reads a pull request's body; empty means "Grug - Chief".
LOOM_PLAN_CHECK=""
# Seconds one repo's read may take in bus.brain status and resume before
# it is named as timed out and the run moves on; empty means 120.
LOOM_REPO_BUDGET=""
# Days a brief defer stays a resume item before resume ages it out and
# counts it in one summary line per goal; empty means 7.
LOOM_BRIEF_DEFER_DAYS=""
# New builds wait at this many open lane/brain PRs. Fixes and verifies continue.
# Positive default followed by optional OWNER/REPO=cap overrides; no zero/off.
# Example: "8 YOUR_OWNER/YOUR_REPO=5". Only configured authors/briefers count.
LOOM_REPO_OPEN_PR_CAP="8"
LOOM_FACTORY="1"
# Minutes a queued ticket waits for its pinned model before the factory gives
# it a free lane of its tier with that lane's own model (a hard pin always
# waits: docs/BRIEF_FORMAT.md); empty means 30, 0 turns the fallback off.
LOOM_PIN_FALLBACK_MINUTES=""
# Minutes the station watches the deploy of each Loom auto-merge before it
# stops (bus/deploy_watch.py); empty means 60.
LOOM_POST_MERGE_WATCH=""
# A lane whose bad outcomes (bad-work findings, reverts, failed deploys, failed
# proof audits) over LOOM_LANE_DEMOTE_DAYS reach LOOM_LANE_DEMOTE_AT is demoted
# until the operator clears it (bus/scorecard.py); empty means 3 and 7.
LOOM_LANE_DEMOTE_AT=""
LOOM_LANE_DEMOTE_DAYS=""
LOOM_ANTHROPIC_BUDGET_USD="YOUR_BUDGET_USD"
LOOM_ANTHROPIC_BUDGET_SINCE="YYYY-MM-DD"
LOOM_ANTHROPIC_BUDGET_EXPIRES="YYYY-MM-DD"
LOOM_ANTHROPIC_FLOOR_USD="YOUR_FLOOR_USD"
# Provider lanes whose credit you never top up (for example "anthropic"): their
# slots held out of credit are no lane-held invariant breach. Empty counts them.
LOOM_NO_TOPUP=""
# Settle operator-claimed issues (claim:<login>, no loom: label) whose pull
# requests merged with the review check passed: empty or "dry" only logs what
# would be done, "on" writes, "off" skips it (docs/BRAIN.md). The cap is the
# most issues settled a run.
LOOM_SETTLE_CLAIMED="dry"
LOOM_SETTLE_CLAIMED_MAX="10"
# One engine claim per ticket, idle engine claims expire after 2 hours unless a
# comment states `waiting: <what> until <time>` (docs/LANES.md): empty or "on"
# writes, "dry" only logs, "off" skips it. The engine claim labels, space
# separated; empty uses the default set in bus/claim_referee.py.
LOOM_CLAIM_REFEREE=""
LOOM_ENGINE_CLAIMS=""
# Additional legacy aliases for needs:human, separated by spaces. Set this
# on the station, brain and dashboard before migrating deployment labels.
# Example: LOOM_LEGACY_HUMAN_LABELS="needs:YOUR_OLD_OPERATOR"
LOOM_LEGACY_HUMAN_LABELS=""
# Optional override for component logs scanned each station pass: one
# name=path per line (relative paths are under LOOM_HOME). Leave empty to
# scan the station log, brain log and every lane service log by default.
LOOM_WATCH=""
# Optional station-only map. The command must be read-only, search at most the
# last 24 hours, and use the supplied literal LOOM_EVIDENCE_NEEDLE. A Live
# string written as a template (`sync: ... (waiting)`, "left N file(s)",
# `export <report>: ...`, "account 'X'") is supported: the needle is its longest
# fixed text, and the station keeps only the lines that match the whole
# template. Keep real deployment commands in the private station plist, never
# in this repository. A Live criterion that needs a string absent is verified on an
# empty answer over LOOM_EVIDENCE_WINDOW_HOURS of log (default 24); the command may
# print `loom-evidence-window-hours: N` when its log is shorter (a pod restart).
LOOM_EVIDENCE_WINDOW_HOURS="24"
LOOM_EVIDENCE_CMDS='{"YOUR_OWNER/YOUR_REPO":"kubectl logs deployment/YOUR_DEPLOYMENT --since=24h --timestamps | grep -F -- \"$LOOM_EVIDENCE_NEEDLE\""}'
# Optional rolling pod logs for the station and evidence service (docs/EVIDENCE.md).
# Example: [{"source":"YOUR_SOURCE","namespace":"YOUR_NAMESPACE","selector":"app=YOUR_APP"}]
LOOM_LOG_CAPTURE="[]"
LOOM_LOG_CAPTURE_RETENTION_HOURS="48"
# Optional station-only map from goal home to one read-only diagnosis command
# (docs/HEALTH.md). It gets a health finding's key in LOOM_HEALTH_KEY and prints
# plain ASCII evidence (rows, log counts, deploy facts); every health brief and
# regression re-brief of that goal quotes up to 40 lines of it. Each key is a
# goal home written owner/name#goal, the goal being its goal issue's number.
LOOM_HEALTH_DIAGNOSE_CMDS='{"YOUR_GOAL_HOME":"YOUR_DIAGNOSE_SCRIPT \"$LOOM_HEALTH_KEY\""}'
# Repos whose own read-only live-evidence adapter (.loom/live-evidence.json on
# the default branch, bus/live_adapter.py) the station's live proof may run, and
# the station variables an adapter is handed (only these, plus PATH, HOME, LANG
# and TMPDIR): name a read-only kubeconfig here, never a GitHub or cloud token.
LOOM_LIVE_EVIDENCE_REPOS=""
LOOM_LIVE_EVIDENCE_PASS_ENV=""
# Optional borrower=lender pairs (comma or space separated). A borrower repo with
# no adapter of its own reads the LOG command of its lender, an opted-in repo
# above, and never its sql. Any repo not paired here gets no adapter.
LOOM_LIVE_EVIDENCE_LENDS=""
# The non-LOOM variables (comma or space separated) lanes/mac/install.sh
# writes into the station plist when they are set at install time, so a
# reinstall keeps them: name KUBECONFIG here when LOOM_LIVE_EVIDENCE_PASS_ENV
# hands it to an adapter. PATH and HOME are skipped.
LOOM_STATION_PASS_ENV=""

# Dashboard read-only GitHub configuration.
LOOM_DASHBOARD_GITHUB_TOKEN=YOUR_READ_ONLY_GITHUB_TOKEN
LOOM_DASHBOARD_GITHUB_API=https://api.github.com
LOOM_DASHBOARD_PORT=8080
# Empty listens on every interface; give the private-network address.
LOOM_DASHBOARD_HOST=
LOOM_DASHBOARD_BUDGET_FLOOR=500
LOOM_DASHBOARD_REFRESH_SECONDS=60
LOOM_UPLOAD_TOKEN=YOUR_TRANSCRIPT_UPLOAD_TOKEN
# A second private value that can only read the brain handoff packet.
LOOM_HANDOFF_TOKEN=YOUR_HANDOFF_READ_TOKEN
# GitHub logins for the two operator sessions shown on /chain, if configured
# (YOUR_PRIMARY_LOGIN and YOUR_SECONDARY_LOGIN).
LOOM_CHAIN_OPERATOR=""
LOOM_CHAIN_SECOND_OPERATOR=""

# Optional sources of the Tiers and allowances page (/tiers, docs/DASHBOARD.md).
# The inference gateway's base URL inside the dashboard's own network (it
# serves /ui/stats and /ui/state, no token); empty shows those panels as not
# configured.
LOOM_GATEWAY_URL=http://YOUR_GATEWAY_SERVICE:PORT
# The review bot's stats endpoint and its optional bearer token; empty shows
# the review bot's panels as not configured yet.
LOOM_GRUG_STATS_URL=
LOOM_GRUG_STATS_TOKEN=

# Optional goal homes for the dashboard views. Use OWNER/NAME#N for one goal.
LOOM_IMPROVEMENT_HOMES=YOUR_OWNER/YOUR_REPO#1

# Days before an explicitly reversible decision applies its declared default.
LOOM_DECISION_WINDOW_DAYS=3

# Pass steps the station skips, space-separated step names (docs/LANES.md,
# Paused steps). state/station/paused_steps.txt adds names with no reload.
LOOM_PAUSED_STEPS=""

# Repository targets (loom#2584). A fresh clone acts only on the repos
# named here; no code default names another owner's repositories.
# The repos the Muse sweep may close or rewrite in; empty means the sweep
# acts nowhere. It never falls back to the LOOM_REPOS fleet list.
# Example: LOOM_SWEEP_REPOS="YOUR_OWNER/YOUR_SWEEP_REPO"
LOOM_SWEEP_REPOS=""
# The repo factory incidents and validation failures are filed on; empty
# means LOOM_SELF_REPO, else LOOM_STATUS_REPO, else this checkout's origin.
LOOM_FACTORY_REPO=""
# The repo whose issue #2162 the one-time send-back comparison writes to.
# Opt-in: empty means the comparison is off and writes nothing; it never
# falls back to the home repo or the origin, since that issue number is one
# deployment's.
LOOM_SEND_BACK_REPO=""
# The scanner's source repository (YOUR_OWNER/YOUR_SCANNER_REPO). If unset,
# lanes use a local scanner (LOOM_LEAK_SCANNER or the existing default path)
# and make no scanner clone or fetch.
LOOM_INFRA_PUBLIC_REPO=""

# Dashboard, deploy and runner overrides. Leave a key unset for its default.
# A URL or owner/name#N the dashboard backlog view reads instead of GitHub.
LOOM_BACKLOG_SOURCE=""
# The IANA time zone the dashboard renders times in.
LOOM_DASHBOARD_TZ=""
# The CI check name the deploy step waits on.
LOOM_DEPLOY_CHECK=""
# The GitHub login the Muse build lane posts as.
LOOM_MUSE_BUILD_LOGIN=""
# The model-list URL for the OpenCode Go lane.
LOOM_OPENCODE_GO_MODELS_URL=""
# The repo cluster lane runners are dispatched to.
LOOM_RUNNER_REPO=""
# The port the lane transcript viewer serves on.
LOOM_VIEWER_PORT=""

# Lane and model overrides. Timeouts and poll intervals here are in seconds.
LOOM_AGENT_TIMEOUT=""
# The isolated agy account, its home/work directories, binary, keychain,
# optional run-as executable, and executable used to inspect code signing.
LOOM_AGY_BIN=""
LOOM_AGY_CODESIGN=""
LOOM_AGY_HOME=""
LOOM_AGY_KEYCHAIN=""
LOOM_AGY_RUNAS=""
LOOM_AGY_USER=""
LOOM_AGY_WORKDIR=""
# Restrict these subscription lanes to one model.
LOOM_AGY_ONLY_MODEL=""
LOOM_CODEX_ONLY_MODEL=""
# Default model IDs for each lane. A slot's model overrides its lane's.
LOOM_ANTHROPIC_MODEL=""
LOOM_CLAUDE_MODEL=""
LOOM_MUSE_MODEL=""
LOOM_OPENCODE_GO_MODEL=""
LOOM_OPENCODE_GO_1_MODEL=""
LOOM_OPENCODE_GO_2_MODEL=""
LOOM_OPENCODE_GO_3_MODEL=""
LOOM_OPENCODE_GO_4_MODEL=""
LOOM_OPENROUTER_MODEL=""
LOOM_SPARK_MODEL=""
LOOM_WORKERSAI_MODEL=""
LOOM_ZAI_MODEL=""
LOOM_ZEN_MODEL=""
# Optional executable that prints the lane App token at run time.
LOOM_APP_TOKEN_CMD=""
# Prefix for Git clone URLs. Omit to use git@github.com:.
LOOM_CLONE_BASE=""
LOOM_NET_TIMEOUT=""
# Provider endpoints and the header name used for the Go subscription probe.
LOOM_MODELS_STATUS_URL=""
LOOM_OPENCODE_GO_PROBE_URL=""
LOOM_OPENCODE_GO_PROBE_HEADER=""
LOOM_OPENCODE_GO_USAGE_URL=""
LOOM_ZEN_MODELS_URL=""
LOOM_ZEN_PROBE_URL=""
# Set to off to use configured model pins instead of the automatic picker.
LOOM_MODEL_PICK=""
# Per-lane settings use LOOM_<LANE>_<SUFFIX> or LOOM_<SLOT>_<SUFFIX>.
# Uppercase the lane or slot name and replace hyphens with underscores.
# MODEL is a default, MODELS is an ordered ladder of model IDs, OPENCODE is
# the executable path, and PROBE_URL / PROBE_HEADER select the usage probe.
# URL, CONTEXT and OUTPUT describe a hosted inference endpoint and its
# token limits. KEY_SSM, ACCOUNT_SSM and SESSION_SSM are parameter names.
LOOM_OPENCODE_GO_3_OPENCODE=""
LOOM_AGY_KEY_SSM=""
LOOM_ANTHROPIC_KEY_SSM=""
LOOM_COPILOT_KEY_SSM=""
LOOM_OPENCODE_GO_KEY_SSM=""
LOOM_OPENROUTER_KEY_SSM=""
LOOM_WORKERSAI_KEY_SSM=""
LOOM_WORKERSAI_ACCOUNT_SSM=""
LOOM_ZAI_KEY_SSM=""
# Daily free allowance in neurons for the Workers AI meter.
LOOM_WORKERSAI_DAILY_NEURONS=""
# OpenAI-compatible Spark base URL and optional per-slot overrides.
LOOM_SPARK_URL=""
LOOM_SPARK_2_URL=""
LOOM_SPARK_3_URL=""
LOOM_SPARK_4_URL=""
LOOM_SPARK_CONTEXT=""
LOOM_SPARK_OUTPUT=""
# OpenCode executable for the Spark brain rung.
LOOM_SPARK_OPENCODE=""
# Rewrite executable, wall-clock budget, and optional free endpoint budgets.
LOOM_REWRITE_FREE_COOLDOWN=""
LOOM_REWRITE_FREE_TIMEOUT=""
LOOM_REWRITE_FREE_URL=""
LOOM_REWRITE_OPENCODE=""
LOOM_REWRITE_TIMEOUT=""
# Additional directories checked for a working sha256sum, space-separated.
LOOM_SHA256SUM_DIRS=""
# Seconds between watchdog and keepalive checks. The log tail can be off.
LOOM_WATCHDOG_POLL=""
LOOM_KEEPALIVE_SECONDS=""
LOOM_LOG_TAIL=""
LOOM_LOG_TAIL_LINES=""
# Validation concurrency, timeouts and worker count. Slot poll, wait and
# validation timeout are in seconds.
LOOM_CHECK_SLOTS=""
LOOM_CHECK_SLOT_POLL=""
LOOM_CHECK_SLOT_WAIT=""
LOOM_CHECK_TIMEOUT=""
LOOM_CHECK_WORKERS=""
LOOM_TEST_TIMEOUT=""
# Scanner executable script and SSM deny-list parameter name.
LOOM_LEAK_SCANNER=""
LOOM_LEAK_DENY_SSM=""
# Colon-separated directories to snapshot into a lane's sandbox.
LOOM_SKILL_DIRS=""

# Cluster runners and standalone lane pods (docs/LANES.md).
# A comma- or space-separated slot list, the job pool size, and the gateway
# URL inside the cluster. See docs/LANES.md for the workflow's GitHub settings.
LOOM_RUNNER_SLOTS=""
LOOM_RUNNER_POOL_MAX=""
LOOM_RUNNER_GATEWAY_URL=""
LOOM_CODEX_SESSION_SSM=""
LOOM_CLAUDE_KEY_SSM=""
# Pod slot list, interval in seconds, sandbox (seatbelt or bwrap), and
# whether to remove each run's scratch tree (1). LOOM_SSM_DIR can point to
# a read-only tree of staged SSM values on a standalone lane pod.
LOOM_POD_SLOTS=""
LOOM_POD_INTERVAL=""
LOOM_SANDBOX=""
LOOM_DROP_TREES=""
LOOM_SSM_DIR=""
# Required bwrap controls. Supply blocked IPv4:port pairs and one reachable
# host:port. The probe timeout and recheck interval are in seconds.
LOOM_EGRESS_DENY_PROBES=""
LOOM_EGRESS_ALLOW_PROBE=""
LOOM_EGRESS_PROBE_SECONDS=""
LOOM_EGRESS_RECHECK_SECONDS="60"
# Comma- or space-separated DNS zones for lane live checks.
LOOM_LIVE_CHECK_ZONES=""

# GitHub Apps for the lanes and brain, in the same format as the station
# App above. For each App, supply an ID, an installation ID and one key source.
LOOM_LANES_GITHUB_APP_ID=""
LOOM_LANES_GITHUB_APP_INSTALLATION_ID=""
LOOM_LANES_GITHUB_APP_KEY_SSM=""
LOOM_LANES_GITHUB_APP_KEY_FILE=""
LOOM_BRAIN_GITHUB_APP_ID=""
LOOM_BRAIN_GITHUB_APP_INSTALLATION_ID=""
LOOM_BRAIN_GITHUB_APP_KEY_SSM=""
LOOM_BRAIN_GITHUB_APP_KEY_FILE=""

# macOS installation and scheduling. BRAIN, DEPLOY and VIEWER accept 0 to
# turn them off. DASHBOARD=1 installs it and DASHBOARD=0 removes it.
LOOM_BRAIN=""
LOOM_DASHBOARD=""
LOOM_DEPLOY=""
LOOM_DEPLOY_BRANCH=""
LOOM_VIEWER=""
# STATION_WAIT counts 0.2-second lock attempts. STATION_INTERVAL and
# PASS_DEADLINE are in seconds.
LOOM_STATION_WAIT=""
LOOM_STATION_INTERVAL=""
LOOM_PASS_DEADLINE=""
# Minute marks past the hour. Use an empty BRAIN_AT for BRAIN_INTERVAL (in
# seconds) instead. An empty BRAIN_YIELD_AT reserves no times for other brains.
LOOM_BRAIN_AT="25 55"
LOOM_BRAIN_INTERVAL=""
LOOM_BRAIN_YIELD_AT="10 40"
# Brain identity, backup holders, rung order and Claude rung model. Scope is
# all or live. MINUTES is the tick time limit and WAIT is the lock wait.
LOOM_BRAIN_HOLDER=""
LOOM_BRAIN_BACKUP_HOLDERS=""
LOOM_BRAIN_LADDER=""
LOOM_BRAIN_MODEL=""
LOOM_BRAIN_MINUTES=""
LOOM_BRAIN_SCOPE=""
LOOM_BRAIN_WAIT=""
# Any nonempty value opts the brain into a Fabric question.
LOOM_BRAIN_FABRIC_ASK=""

# Storage and host safeguards. A station can opt into a shared state backend
# (postgres) and a lease (1). Lease TTL is in seconds and ID names this station.
LOOM_STATE_BACKEND=""
LOOM_STATION_LEASE=""
LOOM_STATION_LEASE_TTL=""
LOOM_STATION_ID=""
# Use 0 to turn off the cross-host GitHub guard.
LOOM_STATION_GUARD=""
# PostgreSQL for shared state or dashboard transcripts. Supply the password
# through the private environment. Set TRANSCRIPTS_MEMORY=1 for in-memory use.
LOOM_DB_HOST=""
LOOM_DB_NAME=""
LOOM_DB_USER=""
LOOM_DB_PASSWORD=""
LOOM_TRANSCRIPTS_MEMORY=""
# Log retention in days, total size in GB and rotation size in MB.
LOOM_LOG_KEEP_DAYS=""
LOOM_LOG_MAX_GB=""
LOOM_LOG_ROTATE_MB=""
# Free space in GB for pausing new work and for starting the watchdog.
# DISK_FREE_MIN_GB is an older name for MIN_FREE_GB.
LOOM_MIN_FREE_GB=""
LOOM_DISK_FREE_MIN_GB=""
LOOM_DISK_WATCHDOG_GB=""
# Archive directory, scratch retention in days, and optional thin snapshots.
LOOM_DISK_ARCHIVE_DIR=""
LOOM_DISK_RUN_DAYS=""
LOOM_THIN_SNAPSHOTS=""

# Factory policy and routing (docs/BRAIN.md and docs/LANES.md).
# Comma-separated auto-merge tiers, hourly caps, and extra blocking rules.
# Omit AUTO_MERGE_TIERS for the default tiers. Empty disables auto-merge.
# Example: LOOM_AUTO_MERGE_TIERS="docs-tests,app-code"
LOOM_AUTO_MERGE_TIERS=""
LOOM_AUTO_MERGE_PER_HOUR=""
LOOM_AUTO_MERGE_PER_REPO_HOUR=""
LOOM_ELDER_BLOCKING_RULES=""
# Review bot slug, review-debt author logins and re-review request text.
LOOM_REVIEW_BOT=""
LOOM_REVIEW_AUTHORS=""
LOOM_REVIEW_AGAIN=""
# Logins trusted to apply loom:revert. Omit for the default allowlist.
LOOM_REVERT_LABELERS="YOUR_TRUSTED_LOGIN"
# Shadow policy, target repositories and optional ledger path.
LOOM_SHADOW=""
LOOM_SHADOW_REPOS=""
LOOM_SHADOW_LEDGER=""
# Repository list allowed to merge without test changes, and optional
# endpoint and model for the check that a change fits its ticket.
LOOM_NO_TEST_REPOS=""
LOOM_SCOPE_CHECK_URL=""
LOOM_SCOPE_CHECK_MODEL=""
# Caps for open epics per goal, unverified work, moves on unclaimed work,
# automatic retries and fix rounds. Repair epics are space-separated refs.
LOOM_GOAL_CAP=""
LOOM_UNVERIFIED_LIMIT=""
LOOM_UNCLAIMED_MOVE_CAP=""
LOOM_RETRY_MAX=""
LOOM_FIX_ROUNDS=""
LOOM_REPAIR_EPICS=""
# Hours before rerouting when a pinned lane is absent or reclaiming idle work.
LOOM_NO_LANE_REROUTE=""
LOOM_CLAIM_IDLE_HOURS=""
# Seconds to settle merge checks or wait for the merge queue's result.
LOOM_MERGE_SETTLE_SECONDS=""
LOOM_MERGE_ASYNC_SECONDS=""
# Additional human claim markers, "LOGIN:PHRASE|ALTERNATE" entries separated
# by semicolons or newlines. Mention allowlist is a list of logins.
LOOM_HUMAN_CLAIMS=""
LOOM_MENTION_ALLOW=""
# Scorecard demotion and zero-completion thresholds.
LOOM_LANE_DEMOTE_RATE=""
LOOM_LANE_ZERO_DONE_AT=""
LOOM_LANE_ZERO_DONE_BRIEFS=""
# Model cooldown state file, minimum sample size, threshold and time bounds.
LOOM_BENCH_STATE_FILE=""
LOOM_BENCH_MIN_SAMPLE=""
LOOM_BENCH_THRESHOLD=""
LOOM_BENCH_COOLDOWN_SECONDS=""
LOOM_BENCH_MAX_COOLDOWN_SECONDS=""

# Health, evidence and transcript services.
# Health sources are space-separated goal=URL pairs. HEALTH_EVERY is in
# seconds. Optional product base URL, its SSM fallback, and a tailnet proxy.
LOOM_HEALTH_URLS=""
LOOM_HEALTH_EVERY=""
LOOM_PRODUCT_URL=""
LOOM_PRODUCT_URL_SSM=""
LOOM_TAILNET_PROXY=""
# Automatic regression rebrief and friction intake controls.
LOOM_REGRESSION_REBRIEFS=""
LOOM_FRICTION_INTAKE=""
# Evidence server config file, bind address, port, SSM token parameter and
# optional Tailscale executable (docs/EVIDENCE.md).
LOOM_EVIDENCE_CONFIG=""
LOOM_EVIDENCE_BIND_HOST=""
LOOM_EVIDENCE_PORT=""
LOOM_EVIDENCE_TOKEN_SSM=""
LOOM_TAILSCALE_BIN=""
# Base URL for transcript uploads and the SSM parameter for its token.
# CODEX_SESSIONS can override the local Codex session directory.
LOOM_TRANSCRIPT_URL=""
LOOM_TRANSCRIPT_TOKEN_SSM=""
LOOM_CODEX_SESSIONS=""
# Ask urgency scoring (off, shadow or act), API key SSM parameter, model,
# daily token cap, and optional thresholds for each routing decision.
LOOM_URGENCY_MODE=""
LOOM_URGENCY_KEY_SSM=""
LOOM_URGENCY_MODEL=""
LOOM_URGENCY_DAILY_TOKENS=""
LOOM_URGENCY_EXPOSURE=""
LOOM_URGENCY_DUPLICATE=""
LOOM_URGENCY_URGENT=""
LOOM_URGENCY_URGENT_PERSON=""
LOOM_URGENCY_DIGEST=""

# Internal variables. Loom supplies these to child processes:
# LOOM_BRIEFERS, LOOM_CHANGED_FILES, LOOM_CHECK_SANDBOX, LOOM_CLAUDE_AUTH_FILE,
# LOOM_CLUSTER_RUNNER, LOOM_CODEX_AUTH_FILE, LOOM_DESELECT_TESTS,
# LOOM_EVIDENCE_NEEDLE, LOOM_EVIDENCE_SINCE, LOOM_HEALTH_KEY,
# LOOM_JOB_DIR, LOOM_ROOT.
# Internal test overrides: LOOM_BRAIN_NOW, LOOM_BRAIN_WAIT_STEP,
# LOOM_CGROUP_ROOT, LOOM_JOB_EVENT, LOOM_POD_ONCE, LOOM_TEST_OPENCODE2.

# Expected Fabric review outputs (off when empty). JSON config, docs/FABRIC_REVIEWS.md.
# Reuse the existing workspace key; never put the key itself here.
LOOM_FABRIC_KEY_SSM=""
LOOM_FABRIC_REVIEW_NOTES=''

# The review sweep (docs/LANES.md, "The review sweep"): off. Review is the
# review bot's alone; only "on" here dispatches sweep reviews. The other
# settings apply once it is on: empty means the default named on each line,
# and 0 seconds turns the sweep off.
LOOM_REVIEW_SWEEP=""
# Seconds between sweeps; empty means 900.
LOOM_REVIEW_SWEEP_EVERY=""
# Hours a pull request's head must age before it is reviewed; empty means 2.
LOOM_REVIEW_SWEEP_HOURS=""
# Review briefs one sweep dispatches at most; empty means 6.
LOOM_REVIEW_SWEEP_PER_RUN=""
# Seconds before a head with no verdict is dispatched again; empty means 14400.
LOOM_REVIEW_SWEEP_RETRY=""
# Review lanes in order of preference; empty means "codex-2 agy".
LOOM_REVIEW_LANES=""
# lane=App slug pairs: the reviewer App that posts each lane's verdict, its
# id and key read from SSM under /fleet/github-apps/<slug>/. Empty means
# "codex-2=agent-openai-codex-luna agy=agent-google-gemini".
LOOM_REVIEW_APPS=""
# The App slugs whose verdict counts as an independent review; empty means
# the five fleet reviewer Apps named in docs/LANES.md.
LOOM_FLEET_REVIEWERS=""
